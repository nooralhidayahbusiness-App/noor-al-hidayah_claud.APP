<?xml version="1.0" encoding="utf-8"?>
<!-- الإشعار الدائم: النسخة الموسّعة (التصميم الكامل) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="ltr"
    android:orientation="vertical"
    android:paddingBottom="10dp"
    android:paddingEnd="12dp"
    android:paddingStart="12dp"
    android:paddingTop="8dp">

    <!-- السطر 1: الشعار + اسم التطبيق ........ الصلاة القادمة -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="6dp"
            android:scaleType="fitCenter"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:id="@+id/pc_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/pc_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAppearance="@android:style/TextAppearance.Material.Notification"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- السطر 2: اسم الصلاة بالعربية + بالإنجليزية -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/pc_name_ar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pc_name_en"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:maxLines="1"
            android:textAppearance="@android:style/TextAppearance.Material.Notification"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- السطر 3: العدّاد الكبير -->
    <Chronometer
        android:id="@+id/pc_counter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textSize="46sp"
        android:textStyle="bold" />

    <!-- السطر 4: التاريخ الميلادي ........ التاريخ الهجري -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/pc_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAppearance="@android:style/TextAppearance.Material.Notification"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/pc_hijri"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAppearance="@android:style/TextAppearance.Material.Notification"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
